# Regenerated exactly with tools/reloc2.py + tools/genall.py + tools/argcount.py.
/gen/
# Built binaries, .app bundles, distribution zip, embedded game data
/out/

# --- Personal / session recordings ---
/session.jsonl
/Claude outputs/
# Raw session screenshots (except selected/ and report/)
/screenshots/*
!/screenshots/selected/
!/screenshots/report/

# --- Environment / temporary ---
/.venv/
__pycache__/
*.pyc
.DS_Store
*.o
*.log

# Old version archive (gen/ and out/ derivatives; see arsiv/v1/OKUBENI.txt)
/arsiv/
